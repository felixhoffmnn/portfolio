---
interface Props {
  variant: "primary" | "ghost" | "link";
  size: "sm" | "icon-sm" | "none";
  href: string;
  target?: string;
  rel?: string;
  "aria-label"?: string;
}

const { variant, size, href, target, rel, "aria-label": ariaLabel } = Astro.props;
const resolvedRel = rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

<a
  href={href}
  target={target}
  rel={resolvedRel}
  aria-label={ariaLabel}
  data-slot="button"
  data-variant={variant}
  data-size={size}
>
  <slot />
</a>
