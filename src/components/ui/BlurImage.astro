---
import { Image } from "astro:assets";
import { generateBlurhashDataUri } from "@/utils/blurhash";

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  loading?: "lazy" | "eager";
  quality?: "low" | "mid" | "high" | "max" | number;
  class?: string;
  imgClass?: string;
}

const { src, alt, width, loading = "lazy", quality = "high", class: className, imgClass } = Astro.props;

const placeholderSrc = await generateBlurhashDataUri(src);
---

<div class:list={["relative overflow-hidden", className]}>
  <img src={placeholderSrc} alt="" aria-hidden="true" class="absolute inset-0 size-full object-cover" />
  <Image
    src={src}
    alt={alt}
    width={width}
    quality={quality}
    loading={loading}
    class:list={["relative size-full object-cover object-center text-transparent", imgClass]}
  />
</div>
