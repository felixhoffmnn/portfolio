---
import type { IPublication } from "@/types";

interface Props {
  item: IPublication;
}

const { item } = Astro.props;
---

<div class="grid gap-2">
  <div class="flex flex-wrap items-center justify-between gap-1">
    <h3 class="text-xl font-semibold">
      {
        item.url ? (
          <a
            class="group no-underline!"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${item.title} (öffnet in einem neuen Tab)`}
          >
            <span class="underline-offset-4 group-hover:underline">{item.title}</span>
          </a>
        ) : (
          item.title
        )
      }
    </h3>
    {item.date && <p class="text-muted-foreground text-sm">{item.date}</p>}
  </div>
  <p class="text-highlight text-sm">{item.venue}</p>
  <p class="text-sm">{item.authors.join(", ")}</p>
</div>
