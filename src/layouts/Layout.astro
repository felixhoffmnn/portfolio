---
import "@fontsource-variable/inter";
import "@fontsource-variable/outfit";

import "@/styles/global.css";

import laptopImage from "@/assets/images/laptop.jpg";
import Footer from "@/components/general/Footer.astro";
import Navbar from "@/components/general/Navbar.astro";
import { info } from "@/data/info";

interface Props {
  frontmatter: { title?: string; description: string; ogImageUrl?: string; label: string };
}

const {
  frontmatter: { title, description, ogImageUrl, label },
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, info.baseUrl).href;
const socialImage = ogImageUrl ?? laptopImage.src;
---

<html lang="de">
  <head>
    <title>{title ? `${title} - ${info.name}` : `${info.name} - Portfolio`}</title>
    <meta charset="UTF-8" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={info.name} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={info.baseUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={info.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={info.twitterHandle} />
    <meta name="twitter:title" content={info.name} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={info.twitterHandle} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      const getThemePreference = () => {
        try {
          const stored = localStorage.getItem("theme");
          if (stored) return stored;
        } catch (_) {}
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };
      document.documentElement.classList[getThemePreference() === "dark" ? "add" : "remove"]("dark");
    </script>
  </head>
  <body class="mx-auto max-w-(--breakpoint-xl) px-6">
    <Navbar />
    <main data-slot="container" class="space-y-16 md:space-y-20 lg:space-y-24" aria-label={label}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
